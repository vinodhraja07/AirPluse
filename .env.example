# ==============================================================================
# AirPulse AI — Environment Configuration & Live Telemetry API Keys
# ==============================================================================

# 1. Anthropic API Key (Powering Claude Sonnet 5 AI Environmental Copilot)
# How to get it:
#   1. Go to https://console.anthropic.com/
#   2. Sign up or log in
#   3. Click "API Keys" -> "Create Key"
#   4. Paste your API key below:
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 2. OpenAQ API Key (Recommended for live real-world sensor streams across India)
# How to get it:
#   1. Go to https://explore.openaq.org/ or https://openaq.org/
#   2. Sign up for a free account
#   3. Click your Profile -> API Keys -> Create API Key
#   4. Paste your API key below:
OPENAQ_API_KEY=your_openaq_api_key_here

# 3. World Air Quality Index (WAQI) Token (Optional secondary live CPCB sensor backup)
# How to get it:
#   1. Go to https://aqicn.org/data-platform/token/
#   2. Enter your email and name
#   3. You will instantly receive a free token in your inbox
#   4. Paste your token below:
WAQI_API_TOKEN=your_waqi_api_token_here

# 4. Server Configuration
PORT=8080
HOST=127.0.0.1
DEBUG=False
